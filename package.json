{
  "name": "voronia2",
  "private": true,
  "version": "2.0.0-stage9.11.0",
  "type": "module",
  "description": "Voronia 2.0 — модульный rewrite монолита v0.0.41 (ТЗ ред. 1.0). Баланс меняется только через ledger (ТЗ §15).",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "build:single": "vite build --config vite.config.single.ts",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "check:arch": "node tools/check_arch.mjs",
    "check:size": "node tools/check_size.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "extract": "node tools/extract_stage0.cjs",
    "ci": "npm run lint && npm run typecheck && npm run typecheck:node && npm run check:arch && npm run test && npm run build && npm run build:single && npm run check:size",
    "check:stage9.8": "node tools/check_stage9_8.mjs"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.13.0",
    "@types/three": "^0.170.0",
    "eslint": "^9.20.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.4.2",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.1.0",
    "vite-plugin-singlefile": "^2.1.0",
    "vitest": "^3.0.5"
  }
}
