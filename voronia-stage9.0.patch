+      id: `sys:bg:${index}`,
+      seed: systemSeed,
+      position,
+      spiral: input.spiral,
+      hostNodeId: null,
+      charted: true,
+      core: false,
+      ordinal: index + 1,
+      planets: buildSystemOrbits(systemSeed, star, {
+        min: SYSTEM_POLICY.freeMinPlanets,
